#!/bin/sh
# managed by lmde7-fde — emit a GRUB menuentry chainloading each UKI on the ESP
#
# Newest first, and the newest carries the fixed id "lmde-uki-latest" so
# GRUB_DEFAULT can name it and keep naming it across kernel installs. A plain
# glob would sort lexically, which puts lmde-6.12.101 AHEAD of lmde-7.2.0 —
# i.e. the oldest kernel first and "latest" pointing at the wrong one.
set -e

ESP="{{ uki_esp_mount }}"
DIR="$ESP/{{ uki_dir }}"

[ -d "$DIR" ] || exit 0

FSUUID="$(grub-probe --target=fs_uuid "$ESP" 2>/dev/null || true)"
[ -n "$FSUUID" ] || exit 0

# -V is version sort: 7.2.0 > 6.12.101 > 6.12.48, which plain sort gets wrong.
first=1
for uki in $(ls -1 "$DIR"/*.efi 2>/dev/null | sort -V -r); do
  [ -e "$uki" ] || continue
  base="$(basename "$uki")"
  ver="${base%.efi}"
  if [ "$first" = 1 ]; then
    id="lmde-uki-latest"
    title="LMDE UKI $ver (latest)"
    first=0
  else
    id="lmde-uki-$ver"
    title="LMDE UKI $ver"
  fi
  cat <<EOF
menuentry '$title' --id '$id' {
	insmod part_gpt
	insmod fat
	insmod chain
	search --no-floppy --fs-uuid --set=root $FSUUID
	chainloader /{{ uki_dir }}/$base
}
EOF
done
